{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchdeck",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "watchdeck.zalize.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchdeck",
      "database_id": "2076cda7-0d0b-4e90-9d39-8a28b10294fd"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "1685d02e54c54ff39d3a394e38799a82"
    }
  ],
  "vars": {
    "SITE_URL": "https://watchdeck.zalize.com",
    "PAYWALL_ENABLED": "false"
  }
}
