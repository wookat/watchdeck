{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchdeck",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "routes": [
    { "pattern": "watchdeck.zalize.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchdeck",
      "database_id": "2076cda7-0d0b-4e90-9d39-8a28b10294fd"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "1685d02e54c54ff39d3a394e38799a82"
    }
  ],
  "vars": {
    "SITE_URL": "https://watchdeck.zalize.com",
    "PAYWALL_ENABLED": "false",
    "ADMIN_EMAIL": "wookat520@gmail.com",
    // Cloudflare Turnstile widget site key (public). Currently the official always-pass TEST key —
    // swap for the real widget key once created in dash → Turnstile; secret lives in `wrangler secret put TURNSTILE_SECRET`.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
